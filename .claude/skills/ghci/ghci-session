#!/usr/bin/env bash
set -euo pipefail

GHCI_DIR="/tmp/ghci-sessions"
mkdir -p "$GHCI_DIR"

SENTINEL='===GHCI_DONE_XYZZY==='

strip_ansi() {
  sed $'s/\x1bE/\\\n/g; s/\x1bD/\\\n/g; s/\x1b\[[0-9;?]*[a-zA-Z]//g; s/\x1b\][^\x07]*\x07//g; s/\x1b(B//g; s/\x1b[=>]//g; s/\x1b[A-Za-z]//g; s/\r//g; s/\x0f//g'
}

has_sentinel_output() {
  grep -F "$SENTINEL" | grep -qvF "putStrLn"
}

session_name() { echo "ghci-$1"; }
log_file()     { echo "$GHCI_DIR/$1.log"; }
lock_file()    { echo "$GHCI_DIR/$1.lock"; }

acquire_lock() {
  local lock="$1"
  local deadline=$((SECONDS + 310))
  while ! mkdir "$lock" 2>/dev/null; do
    if [ $SECONDS -ge $deadline ]; then
      echo "ERROR: Could not acquire lock (another command running?)"
      return 1
    fi
    sleep 0.2
  done
}

release_lock() {
  rmdir "$1" 2>/dev/null || true
}

cmd_start() {
  local name="$1"
  shift
  local component="$*"
  local sess log
  sess=$(session_name "$name")
  log=$(log_file "$name")

  if tmux has-session -t "$sess" 2>/dev/null; then
    echo "Session '$name' already running. Use 'send' to interact or 'stop' to restart."
    return 0
  fi

  : > "$log"

  # Create session with a waiting shell, set up pipe-pane BEFORE any output
  tmux new-session -d -s "$sess" -x 250 -y 50
  tmux pipe-pane -t "$sess" "stdbuf -oL cat >> '$log'"
  # Now send the actual command
  tmux send-keys -t "$sess" "cd /work && exec cabal repl $component 2>&1" Enter

  echo "Starting 'cabal repl $component' ..."

  # Wait for GHCi to be ready by looking for "modules loaded" or "module loaded"
  local deadline=$((SECONDS + 300))
  while true; do
    if [ $SECONDS -ge $deadline ]; then
      echo "ERROR: Timed out (300s) waiting for GHCi"
      echo "=== Last 40 lines ==="
      strip_ansi < "$log" | tail -40
      tmux kill-session -t "$sess" 2>/dev/null || true
      return 1
    fi
    if strip_ansi < "$log" | grep -qE 'modules? loaded'; then
      break
    fi
    # Also check for failure
    if strip_ansi < "$log" | grep -qE 'Failed|cannot satisfy|Could not find module|cabal:.*Error'; then
      echo "ERROR: cabal repl failed to start"
      echo "=== Output ==="
      strip_ansi < "$log" | tail -50
      tmux kill-session -t "$sess" 2>/dev/null || true
      return 1
    fi
    sleep 2
  done

  # Brief pause for prompt to render, then confirm with sentinel
  sleep 1
  local pos
  pos=$(wc -c < "$log" 2>/dev/null || echo 0)

  tmux send-keys -t "$sess" -l "putStrLn \"$SENTINEL\""
  tmux send-keys -t "$sess" Enter

  local sdeadline=$((SECONDS + 30))
  while true; do
    if [ $SECONDS -ge $sdeadline ]; then
      echo "WARNING: Sentinel not confirmed, but modules loaded. Proceeding."
      break
    fi
    if tail -c "+$((pos + 1))" "$log" 2>/dev/null | strip_ansi | has_sentinel_output; then
      break
    fi
    sleep 0.3
  done

  # Clear log for a clean start
  : > "$log"
  echo "GHCi session '$name' ready."
}

cmd_send() {
  local name="$1"
  shift
  local ghci_cmd="$*"
  local sess log lock
  sess=$(session_name "$name")
  log=$(log_file "$name")
  lock=$(lock_file "$name")

  if ! tmux has-session -t "$sess" 2>/dev/null; then
    echo "ERROR: No session '$name'. Start one first."
    return 1
  fi

  acquire_lock "$lock" || return 1
  trap "release_lock '$lock'" RETURN

  local pos
  pos=$(wc -c < "$log" 2>/dev/null || echo 0)

  tmux send-keys -t "$sess" -l "$ghci_cmd"
  tmux send-keys -t "$sess" Enter
  sleep 0.2
  tmux send-keys -t "$sess" -l "putStrLn \"$SENTINEL\""
  tmux send-keys -t "$sess" Enter

  local deadline=$((SECONDS + 300))
  while true; do
    if [ $SECONDS -ge $deadline ]; then
      echo "ERROR: Command timed out (300s)"
      echo "=== Partial output ==="
      tail -c "+$((pos + 1))" "$log" 2>/dev/null | strip_ansi | tail -50
      return 1
    fi
    if tail -c "+$((pos + 1))" "$log" 2>/dev/null | strip_ansi | has_sentinel_output; then
      break
    fi
    sleep 0.3
  done

  # Extract output: skip sentinel and its echo
  tail -c "+$((pos + 1))" "$log" \
    | strip_ansi \
    | grep -vF "$SENTINEL" \
    | grep -v 'putStrLn.*XYZZY' \
    | head -1000
}

cmd_send_multi() {
  local name="$1"
  local sess log lock
  sess=$(session_name "$name")
  log=$(log_file "$name")
  lock=$(lock_file "$name")

  if ! tmux has-session -t "$sess" 2>/dev/null; then
    echo "ERROR: No session '$name'."
    return 1
  fi

  acquire_lock "$lock" || return 1
  trap "release_lock '$lock'" RETURN

  local pos
  pos=$(wc -c < "$log" 2>/dev/null || echo 0)

  while IFS= read -r line; do
    tmux send-keys -t "$sess" -l "$line"
    tmux send-keys -t "$sess" Enter
    sleep 0.1
  done

  sleep 0.2
  tmux send-keys -t "$sess" -l "putStrLn \"$SENTINEL\""
  tmux send-keys -t "$sess" Enter

  local deadline=$((SECONDS + 300))
  while true; do
    if [ $SECONDS -ge $deadline ]; then
      echo "ERROR: Command timed out"
      tail -c "+$((pos + 1))" "$log" 2>/dev/null | strip_ansi | tail -50
      return 1
    fi
    if tail -c "+$((pos + 1))" "$log" 2>/dev/null | strip_ansi | has_sentinel_output; then
      break
    fi
    sleep 0.3
  done

  tail -c "+$((pos + 1))" "$log" \
    | strip_ansi \
    | grep -vF "$SENTINEL" \
    | grep -v 'putStrLn.*XYZZY' \
    | head -1000
}

cmd_stop() {
  local name="$1"
  local sess
  sess=$(session_name "$name")

  if tmux has-session -t "$sess" 2>/dev/null; then
    tmux send-keys -t "$sess" -l ':quit'
    tmux send-keys -t "$sess" Enter
    sleep 1
    tmux kill-session -t "$sess" 2>/dev/null || true
    rm -f "$(log_file "$name")"
    rmdir "$(lock_file "$name")" 2>/dev/null || true
    echo "Session '$name' stopped."
  else
    echo "No session '$name' found."
  fi
}

cmd_status() {
  local name="$1"
  local sess
  sess=$(session_name "$name")

  if tmux has-session -t "$sess" 2>/dev/null; then
    echo "Session '$name' is RUNNING."
    echo "=== Last 5 lines ==="
    tmux capture-pane -t "$sess" -p | strip_ansi | tail -5
  else
    echo "Session '$name' is NOT running."
  fi
}

cmd_list() {
  local sessions
  sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
    | grep '^ghci-' | sed 's/^ghci-//' || true)
  if [ -n "$sessions" ]; then
    echo "Active GHCi sessions:"
    echo "$sessions"
  else
    echo "No active GHCi sessions."
  fi
}

cmd_log() {
  local name="$1"
  local lines="${2:-50}"
  local log
  log=$(log_file "$name")
  if [ -f "$log" ]; then
    strip_ansi < "$log" | tail -"$lines"
  else
    echo "No log for session '$name'."
  fi
}

case "${1:-help}" in
  start)    cmd_start "${2:?name required}" "${@:3}" ;;
  send)     cmd_send "${2:?name required}" "${@:3}" ;;
  multi)    cmd_send_multi "${2:?name required}" ;;
  stop)     cmd_stop "${2:?name required}" ;;
  status)   cmd_status "${2:?name required}" ;;
  list)     cmd_list ;;
  log)      cmd_log "${2:?name required}" "${3:-50}" ;;
  stop-all)
    for sess in $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^ghci-' || true); do
      cmd_stop "${sess#ghci-}"
    done
    ;;
  help|*)
    cat <<'USAGE'
Usage: ghci-session <command> [args...]

Session management:
  start <name> [cabal-component]  Start a cabal repl session
  stop <name>                     Stop a session
  stop-all                        Stop all GHCi sessions
  status <name>                   Check session status
  list                            List active sessions
  log <name> [lines]              Show last N lines of session log

Interaction:
  send <name> <ghci-command>      Send a command and return output
  multi <name> < input.txt        Send multi-line input from stdin
USAGE
    ;;
esac

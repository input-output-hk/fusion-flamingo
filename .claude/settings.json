{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.config/claude/hooks/project-rules.sh",
            "timeout": 5,
            "statusMessage": "Loading project rules..."
          }
        ]
      }
    ]
  }
}
